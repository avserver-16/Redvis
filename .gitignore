# ====================================================================
# Global Dependency Blocks
# ====================================================================
# Ignore node_modules inside any nested subdirectory (backend & frontend)
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ====================================================================
# Compiled C++ Executables & Binaries
# ====================================================================
# Wipes local engine executables and OS build outputs
*.exe
*.o
*.obj
*.out
*.dll
*.so
*.dylib
**/RedisEngine/cache.exe
**/backend/cache_engine.exe

# ====================================================================
# Frontend Build and IDE Outputs
# ====================================================================
# Ignore Vite production builds, local logs, and editor configs
**/frontend/dist/
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# ====================================================================
# Environment & Secrets
# ====================================================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
